{
  "name": "fitai-x-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "FitAI X — Intelligent Hypertrophy & Bio-Recovery Platform",
  "scripts": {
    "start:backend": "cd backend && npm run dev",
    "start:frontend": "cd frontend && npx expo start --web --port 8081",
    "start:frontend:clear": "cd frontend && npx expo start -c",
    "test": "cd tests && npx playwright test",
    "test:e2e": "cd tests && npx playwright test --project=e2e",
    "test:api": "cd tests && npx playwright test --project=api",
    "test:headed": "cd tests && npx playwright test --project=e2e --headed",
    "test:report": "cd tests && npx playwright show-report playwright-report"
  }
}
